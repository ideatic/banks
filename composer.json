{
  "name": "ideatic/banks",
  "description": "Tools for bank-related file handling (Norma 43, CAMT.053)",
  "keywords": [
    "banks",
    "norma43",
    "camt053"
  ],
  "type": "library",
  "license": "MIT",
  "authors": [
    {
      "name": "Javier Marín",
      "email": "contacto@ideatic.net",
      "homepage": "http://www.ideatic.net/"
    }
  ],
  "require": {
    "php": ">=8.4",
    "ext-mbstring": "*",
    "ext-bcmath": "*",
    "ext-libxml": "*",
    "ext-simplexml": "*"
  },
  "require-dev": {
    "phpunit/phpunit": "^13.3",
    "phpstan/phpstan": "^2.2",
    "phpstan/phpstan-strict-rules": "^2.0",
    "phpstan/phpstan-phpunit": "^2.0",
    "phpstan/phpstan-deprecation-rules": "^2.0",
    "phpstan/extension-installer": "^1.4"
  },
  "autoload": {
    "classmap": [
      "Banks/"
    ]
  },
  "autoload-dev": {
    "psr-4": {
      "Banks\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit",
    "phpstan": "phpstan analyse --no-progress"
  },
  "config": {
    "allow-plugins": {
      "phpstan/extension-installer": true
    }
  }
}
